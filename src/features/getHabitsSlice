import { createAsyncThunk, createSlice, PayloadAction } from "@reduxjs/toolkit";
import { Query } from "react-native-appwrite"; // adjust import path
import {
  COMPLETIONS_COLLECTION_ID,
  DATABASE_ID,
  databases,
  HABITS_COLLECTION_ID,
} from "../../lib/appwrite";
import { Habit, HabitCompletion } from "../../types/database.type";

// --------- ASYNC THUNKS ------------

// Fetch all habits
export const fetchHabits = createAsyncThunk(
  "habits/fetchHabits",
  async (userId: string, { rejectWithValue }) => {
    try {
      const response = await databases.listDocuments(
        DATABASE_ID,
        HABITS_COLLECTION_ID,
        [Query.equal("user_id", userId)]
      );
      return response.documents as unknown as Habit[];
    } catch (error: any) {
      return rejectWithValue(error.message || "Failed to fetch habits");
    }
  }
);

// Fetch today’s completions
export const fetchTodayCompletions = createAsyncThunk(
  "habits/fetchTodayCompletions",
  async (userId: string, { rejectWithValue }) => {
    try {
      const today = new Date();
      today.setHours(0, 0, 0, 0);

      const response = await databases.listDocuments(
        DATABASE_ID,
        COMPLETIONS_COLLECTION_ID,
        [
          Query.equal("user_id", userId),
          Query.greaterThanEqual("completed_at", today.toISOString()),
        ]
      );

      const completions = response.documents as unknown as HabitCompletion[];
      return completions.map((c) => c.habit_id); // ✅ return only habit IDs
    } catch (error: any) {
      return rejectWithValue(error.message || "Failed to fetch completions");
    }
  }
);

// --------- SLICE ------------

interface HabitsState {
  habits: Habit[];
  completedHabits: string[]; // store just habit IDs
  loading: boolean;
  error: string | null;
}

const initialState: HabitsState = {
  habits: [],
  completedHabits: [],
  loading: false,
  error: null,
};

const habitsSlice = createSlice({
  name: "habits",
  initialState,
  reducers: {
    clearHabits: (state) => {
      state.habits = [];
      state.completedHabits = [];
      state.error = null;
    },
  },
  extraReducers: (builder) => {
    builder
      // fetchHabits
      .addCase(fetchHabits.pending, (state) => {
        state.loading = true;
        state.error = null;
      })
      .addCase(
        fetchHabits.fulfilled,
        (state, action: PayloadAction<Habit[]>) => {
          state.loading = false;
          state.habits = action.payload;
        }
      )
      .addCase(fetchHabits.rejected, (state, action) => {
        state.loading = false;
        state.error = action.payload as string;
      })

      // fetchTodayCompletions
      .addCase(fetchTodayCompletions.pending, (state) => {
        state.loading = true;
        state.error = null;
      })
      .addCase(
        fetchTodayCompletions.fulfilled,
        (state, action: PayloadAction<string[]>) => {
          state.loading = false;
          state.completedHabits = action.payload;
        }
      )
      .addCase(fetchTodayCompletions.rejected, (state, action) => {
        state.loading = false;
        state.error = action.payload as string;
      });
  },
});

export const { clearHabits } = habitsSlice.actions;
export default habitsSlice.reducer;
